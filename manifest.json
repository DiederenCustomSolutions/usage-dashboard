{
  "manifest_version": 3,
  "name": "Usage Dashboard - LLM Scraper",
  "version": "0.27.9",
  "key": "",
  "description": "Automatically monitors and syncs your Claude Pro and ChatGPT Business usage and rolling limits.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "offscreen",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "*://*.claude.ai/*",
    "*://*.chatgpt.com/*",
    "*://z.ai/*",
    "*://*.z.ai/*",
    "*://gemini.google.com/*",
    "https://api.npoint.io/*",
    "https://www.npoint.io/*",
    "https://diederencustomsolutions.github.io/*",
    "https://usage-dashboard-98f1d-default-rtdb.europe-west1.firebasedatabase.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://diederencustomsolutions.github.io/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.claude.ai/*",
        "*://*.chatgpt.com/*",
        "*://z.ai/*",
        "*://*.z.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Open Usage Dashboard"
  }
}
